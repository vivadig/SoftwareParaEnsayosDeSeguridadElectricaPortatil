# =============================================================================
# Configuración del Sistema de Ensayos de Seguridad Eléctrica
# Copiar este archivo como .env y ajustar los valores según el entorno
# =============================================================================

# --- Hardware: ESP32 ---
ESP32_BAUD_RATE=115200
ESP32_TIMEOUT=2
ESP32_RETRY_INTERVAL=5
ESP32_PORT_KEYWORDS=ESP32,CP210x,CP2102
ESP32_STABILIZATION_DELAY=2

# --- Hardware: Relés USB HW-554 ---
RELAY_BOARD_SERIAL=auto
RELAY_SETTLE_DELAY=0.05
RELAY_WATCHDOG_RELAY=8

# --- Hardware: Mapeo de relés para ensayos ---
# Formato: nombre_semantico=numero_de_rele
RELAY_FUGA_ACTIVA=1
RELAY_FUGA_PASIVA=2
RELAY_PAT_POWER=3
RELAY_DIELECTRIC_CLASS1=4
RELAY_DIELECTRIC_CLASS2=5
RELAY_DIELECTRIC_ENABLE=6
RELAY_PAT_ENABLE=7
RELAY_WATCHDOG=8

# --- Hardware: PZEM ---
PZEM_CONSUMPTION=1
PZEM_LEAKAGE=2
PZEM_GROUNDING=3

# --- Hardware: Factores de escala ---
LEAKAGE_CURRENT_MULTIPLIER=10
GROUNDING_VOLTAGE_MULTIPLIER=10
GROUNDING_RESISTANCE_MULTIPLIER=1000
DIELECTRIC_VOLTAGE_MULTIPLIER=10

# --- Umbrales de ensayos ---
CONSUMPTION_CURRENT_MIN_PCT=50
CONSUMPTION_CURRENT_MAX_PCT=105
CONSUMPTION_POWER_MIN_PCT=75
CONSUMPTION_POWER_MAX_PCT=110
ACTIVE_LEAKAGE_MAX_UA=750
PASSIVE_LEAKAGE_MAX_UA=1500
GROUNDING_MAX_MOHM=100
DIELECTRIC_CLASS1_MIN_V=800
DIELECTRIC_CLASS2_MIN_V=2000

# --- Tiempos de ensayo (segundos) ---
TEST_CONSUMPTION_DURATION=5
TEST_ACTIVE_LEAKAGE_DURATION=5
TEST_PASSIVE_LEAKAGE_DURATION=5
TEST_GROUNDING_DURATION=5
TEST_DIELECTRIC_DURATION=5
TEST_INTER_TEST_DELAY=0.2

# --- Correcciones de calibración ---
CORRECTION_VOLTAGE=0.0
CORRECTION_CURRENT=0.0
CORRECTION_ACTIVE_LEAKAGE=0.0
CORRECTION_PASSIVE_LEAKAGE=0.0
CORRECTION_GROUNDING=0.0
CORRECTION_DIELECTRIC=0.0

# --- Base de datos ---
DATABASE_PATH=data/ensayos.db

# --- API REST ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# --- Exportación ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EXPORT_DEFAULT_DIR=~/Desktop

# --- GUI ---
GUI_THEME=dark
GUI_UI_DIR=src/ensayos/gui/resources
